# The public demo requires each tester to provide their own OpenAI API key.
# It deliberately has no server-side OPENAI_API_KEY fallback.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_INSTRUCTIONS=You are a concise, friendly voice assistant. Answer naturally and briefly.

XIRSYS_IDENT=your-xirsys-ident
XIRSYS_SECRET=your-xirsys-secret
XIRSYS_CHANNEL=your-channel-name
XIRSYS_API_BASE=https://global.xirsys.net

# Optional. Xirsys credentials default to 60 seconds.
XIRSYS_ICE_TTL_SECONDS=60

# Optional. When enabled, the server derives a public request IP and the SDK
# sends both `geo=1` and `user_ip`. Enable only after configuring Express trust
# for the exact proxy hop or subnet in your deployment.
XIRSYS_GEO=false
TRUST_PROXY=false

# Recommended when this demo is publicly reachable. Requests to /api/bootstrap
# must come from this exact browser origin. Leave empty for local development.
PUBLIC_ORIGIN=
BOOTSTRAP_RATE_LIMIT_MAX=10
BOOTSTRAP_RATE_LIMIT_WINDOW_MS=60000

# Bind to 127.0.0.1 when a same-host reverse proxy provides public HTTPS.
HOST=0.0.0.0
PORT=3000
